{
  "name": "apteka-server",
  "version": "1.0.0",
  "description": "NestJS backend for Apteka POS",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "node scripts/migrate.mjs",
    "test": "npm run build && node --test",
    "prisma:generate": "node scripts/generate.mjs",
    "prisma:push": "prisma db push",
    "postinstall": "node scripts/generate.mjs"
  },
  "dependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "^5.20.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "prisma": "^5.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
