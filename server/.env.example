# PostgreSQL (Railway выдаёт автоматически как DATABASE_URL)
DATABASE_URL="postgresql://user:password@localhost:5432/apteka?schema=public"

# Порт (Railway проставляет PORT сам)
PORT=3000

# Разрешённые домены фронта через запятую (Vercel). Пусто = разрешить все.
CORS_ORIGIN=

# Ключ подписи токенов входа. ОБЯЗАТЕЛЬНО задайте свой длинный случайный ключ на сервере:
# без него используется общеизвестное значение по умолчанию, и вход можно подделать.
AUTH_SECRET=

# Владелец СЕРВИСА — тот, кто заводит магазины-клиенты и продлевает им подписку.
# Создаётся при первом старте, если учётных записей ещё нет. Под ним доступны ВСЕ
# магазины, поэтому на сервере ОБЯЗАТЕЛЬНО задайте надёжный пароль: без него (или со
# слабым/«admin») сервер в проде откажется заводить владельца и не стартует — так же,
# как без AUTH_SECRET. В разработке без пароля заводится admin/admin.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_NAME=admin
ADMIN_PASSWORD=

# ── Подключения к аптекам ──
# У каждой аптеки своя схема в этой же базе и своё подключение к ней. Именно здесь
# сервис упрётся в предел раньше всего остального: Postgres обычно отдаёт сотню
# подключений на всех. 25 × 2 = 50 — с запасом для панели и миграций.
#
# Предел МЯГКИЙ. Закрываются только те подключения, которыми давно не пользовались;
# если все в работе, предел ненадолго превышается. Нагрузочная проверка показала,
# почему так: жёсткий предел закрывал подключение прямо под идущим запросом, тот
# падал по времени, аптека подключалась заново — и так по кругу.
TENANT_MAX_CLIENTS=25
TENANT_CONNECTION_LIMIT=2

# Сколько подключение считается «в работе» после последнего обращения — такое
# не закрывается никогда. Должно быть больше самой длинной операции: пересчёту
# остатков отведено три минуты.
TENANT_BUSY_MS=240000

# Через сколько простоя подключение закрывается само, даже если место есть.
# Аптека закрылась на ночь — незачем держать её подключение до утра.
TENANT_IDLE_MS=900000

# Наибольший размер тела запроса. Нужен восстановлению резервной копии: оно
# присылает всю базу аптеки одним запросом. Уменьшайте, только если серверу не
# хватает памяти — разбор присланного файла целиком держится в оперативной памяти.
BODY_LIMIT=100mb

# ── Автоматические копии всех аптек ──
# Раз в сутки сервер сам снимает копию с каждой аптеки. Куда — задаётся здесь.
# Не задано ничего — копии НЕ снимаются, и сервер скажет об этом в журнале.
# Молча делать вид, что копии есть, он не станет: хуже отсутствующих копий
# только копии, в которые верят.
#
# Способ первый и правильный — внешнее S3-совместимое хранилище (Cloudflare R2,
# Backblaze B2). Копия, лежащая рядом с базой, от потери сервера не спасает:
# исчезнут оба разом. Ключу доступа хватает права только на запись.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=auto

# Способ второй — папка на диске. Годится, ТОЛЬКО если это подключённый том,
# переживающий перезапуск. На обычной файловой системе контейнера копии исчезнут
# при первой же выкладке.
BACKUP_DIR=

# Час снятия копий по Душанбе (ночь: касса закрыта, база свободна) и сколько
# последних хранить. Имена файлов идут по кругу, поэтому хранилище не растёт.
BACKUP_HOUR=3
BACKUP_KEEP=14

# Демо-данные. При заведении аптеки в панели есть галочка «заполнить
# демонстрационными товарами и продажами» — она и нужна для показа программы.
# Эта переменная осталась для локальной разработки.
AUTO_SEED=false
