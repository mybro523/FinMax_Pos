// ── База панели управления ──
// Здесь живёт то, что относится к сервису целиком, а не к отдельной аптеке: список
// аптек-клиентов, учётные записи для входа, оплаты и журнал действий.
//
// Данные самой аптеки — товары, продажи, остатки, долги — сюда не попадают никогда.
// У каждой аптеки своя схема Postgres со своим набором таблиц, и это разделение —
// единственное, что не даёт одной аптеке увидеть другую. Аптеки конкурируют между
// собой; утечка закупочных цен и долгов клиентов между ними убила бы весь сервис.
//
// Своя схема — значит и свой сгенерированный клиент: набор таблиц здесь другой.
// Он кладётся в node_modules, чтобы путь к нему одинаково находился и из исходников,
// и из собранного dist.

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/admin-client"
}

datasource db {
  provider = "postgresql"
  url      = env("ADMIN_DATABASE_URL")
}

// ── Аптека-клиент ──
// Одна запись — один проданный продукт: одна аптека со своей схемой в базе.
model Pharmacy {
  id   String @id @default(cuid())
  // Короткий код аптеки: им она называется в панели и в журналах. Виден только
  // владельцу сервиса — сотрудники аптеки входят по логину и паролю.
  code String @unique
  name String

  // Кому продано и как связаться. Телефон — рабочий инструмент: продление
  // подписки начинается со звонка, а не с письма.
  ownerName String @default("")
  phone     String @default("")
  city      String @default("")

  // Схема Postgres, в которой лежат данные этой аптеки. Хранится отдельно от кода:
  // код можно переименовать, а схему с данными переносить нельзя.
  schemaName String @unique

  // ── Подписка ──
  // Состояние аптеки не хранится отдельным полем, а считается из этих трёх.
  // Отдельное поле «статус» пришлось бы обновлять по расписанию, и в первый же
  // день, когда задача не отработала, оно разошлось бы с датой оплаты.
  paidUntil DateTime // до какого числа оплачено (для пробного — конец пробного)
  trial     Boolean  @default(true)
  blocked   Boolean  @default(false) // приостановлено вручную владельцем сервиса

  // Сколько дней касса (программа для Windows) может работать без связи с сервером.
  // Подписку проверяет сервер при каждом обмене; дольше этого срока без проверки
  // программа не работает — иначе неоплаченная аптека просто выдернула бы провод.
  offlineDays Int @default(7)

  // Последняя применённая миграция. Схемы аптек обновляются отдельной задачей,
  // а не при старте сервера: три сотни схем по паре секунд — это десять минут
  // недоступности при каждом перезапуске.
  schemaVersion String @default("")

  note      String   @default("")

  // ── Живой ли клиент ──
  // Дата последнего чека в самой аптеке. Лежит здесь, а не считается на лету:
  // за ней надо идти в схему аптеки, и на списке из трёхсот клиентов это триста
  // отдельных запросов. Раз в час фоновый обход записывает её сюда, и панель
  // показывает «оплачена, но не торгует восьмой день» мгновенно.
  //
  // Это самый честный признак того, что клиент уходит: деньги уже получены,
  // а работать он перестал — и скажет об этом только через месяц.
  lastSaleAt   DateTime?
  lastSaleSeen DateTime? // когда последний раз смотрели — чтобы отличить «не торгует» от «ещё не считали»

  // ── Когда звонили и что обещали ──
  // Продление начинается со звонка, а звонков за день бывает десяток. Без отметки
  // владелец сервиса звонит одному дважды, а другому не звонит вовсе.
  calledAt DateTime?
  callNote String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  payments Payment[]
  roles    Role[]

  // Главный экран панели — «у кого заканчивается оплата»
  @@index([paidUntil])
}

// ── Учётная запись для входа ──
// Логин уникален на весь сервис: сотрудник вводит только логин и пароль, без кода
// аптеки, и по логину система понимает, в какую аптеку его пускать.
//
// Личность сотрудника живёт здесь, а не в схеме аптеки. Так проверка доступа —
// один запрос к небольшой таблице вместо запроса в схему аптеки, статус подписки
// приходит тем же запросом, а защита от подбора пароля считает попытки по всему
// сервису. В схеме аптеки остаётся только имя сотрудника: на него ссылаются чеки,
// смены, возвраты и списания, и эта история обязана сохраниться.
model Account {
  id           String @id @default(cuid())
  login        String @unique
  passwordHash String

  // Токены, выданные до этого момента, недействительны. Смена пароля обязана
  // выгонять того, кто им завладел, — иначе менять его бессмысленно.
  passwordChangedAt DateTime @default(now())

  // founder | cashier — сотрудники аптеки; superadmin — владелец сервиса
  role   String  @default("cashier")
  active Boolean @default(true)

  // У владельца сервиса аптеки нет: он обслуживает все
  pharmacyId String?
  pharmacy   Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  // Тот же сотрудник в схеме своей аптеки — на него ссылаются чеки и смены
  tenantUserId String?

  // Роль с набором прав (см. src/auth/permissions.ts). У владельца её нет: он может всё.
  // Кассир без роли — учётная запись из прежней версии, получает права кассира по умолчанию
  roleId  String?
  roleRef Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  payments Payment[]
  actions  AuditLog[]

  @@index([pharmacyId])
  @@index([roleId])
}

// ── Оплата подписки ──
// Деньги принимаются вживую — наличными или переводом, — а здесь остаётся запись
// о том, за что и на сколько продлили. Без журнала спор с клиентом о том, платил
// он в марте или нет, решать нечем.
model Payment {
  id         String   @id @default(cuid())
  pharmacyId String
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(12, 2) // сомони
  months Int     @default(1) // на сколько продлили
  method String  @default("cash") // cash | transfer | other
  note   String  @default("")

  // Кто провёл оплату в панели. Запись переживает удаление учётной записи:
  // история оплат важнее, чем ссылка на того, кто её внёс.
  byAccountId String?
  byAccount   Account? @relation(fields: [byAccountId], references: [id], onDelete: SetNull)

  // Каким стал срок оплаты после этого платежа — чтобы историю можно было
  // прочитать, не пересчитывая её заново
  paidUntilAfter DateTime
  createdAt      DateTime @default(now())

  @@index([pharmacyId])
  @@index([createdAt])
}

// ── Журнал действий в панели ──
// Заводили аптеку, продлевали, приостанавливали, входили под владельцем. Последнее
// особенно важно: заходить в чужую аптеку иногда нужно для поддержки, но это должно
// быть видно — и владельцу сервиса, и потом.
model AuditLog {
  id String @id @default(cuid())

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  // Имя сохраняем строкой: запись должна читаться и после удаления учётной записи
  accountName String @default("")

  pharmacyId   String? // аптека, которой касалось действие
  pharmacyCode String  @default("")

  action String // create | extend | block | unblock | impersonate | restore | …
  detail String @default("")

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([pharmacyId])
}

// ── Роли сотрудников ──
// Имя и набор прав; права — ключи из src/auth/permissions.ts. Роли свои у каждой
// аптеки: владелец заводит их сам. system = 'cashier' — системная роль кассира,
// её нельзя удалить и переименовать, но права в ней владелец меняет свободно.
model Role {
  id          String   @id @default(cuid())
  pharmacyId  String
  pharmacy    Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  system      String?
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accounts Account[]

  @@unique([pharmacyId, name])
  @@index([pharmacyId])
}
