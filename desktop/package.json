{
  "name": "finmax-pos-desktop",
  "productName": "FinMax POS",
  "version": "1.4.7",
  "description": "FinMax POS — касса и склад торговли. Программа для Windows",
  "private": true,
  "author": "FinMax",
  "type": "module",
  "main": "src/main.mjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "electron:dev": "node scripts/dev.mjs",
    "electron:build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "test": "node --test && eslint .",
    "test:app": "playwright test",
