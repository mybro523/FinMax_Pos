# Адрес сервера (NestJS на Railway) — тот же, что у сайта в VITE_API_URL.
# Скопируйте этот файл в «.env» и подставьте свой адрес. Секрета здесь нет:
# это адрес, к которому программа обращается так же, как сайт.
#
# При сборке («npm run electron:build») адрес зашивается внутрь программы.
# На компьютере аптеки изменить его уже нельзя.
APTEKA_API_URL=https://example.up.railway.app/api

# Откуда программа берёт обновления: открытый репозиторий GitHub, в который
# выкладываются установщики («npm run electron:publish»). Тоже зашивается при сборке.
# Не задано — программа соберётся без автообновления.
# APTEKA_UPDATE_REPO=владелец/репозиторий
#
# Ключ GitHub для выкладки сюда НЕ пишут: он задаётся переменной окружения GH_TOKEN
# в том терминале, из которого запускается выкладка.
